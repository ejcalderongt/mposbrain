package com.dtsgt.brainlabtests;

import android.content.Context;
import androidx.test.ext.junit.runners.AndroidJUnit4;
import androidx.test.platform.app.InstrumentationRegistry;
import com.dtsgt.classes.clsDocCuenta;
import com.dtsgt.classes.clsRepBuilder;
import org.json.JSONObject;
import org.junit.Before;
import org.junit.Test;
import org.junit.runner.RunWith;
import java.io.File;
import java.io.FileOutputStream;
import java.nio.charset.StandardCharsets;
import java.nio.file.Files;
import java.util.Locale;
import static org.junit.Assert.*;

/** Component contracts on Android. DB header and physical printer are explicit test doubles. */
@RunWith(AndroidJUnit4.class)
public class BrainTipContractTest {
    private Context context() { return InstrumentationRegistry.getInstrumentation().getTargetContext(); }
    @Before public void locale() { Locale.setDefault(Locale.US); }
    private void record(String name, Object... values) throws Exception {
        JSONObject out=new JSONObject(); out.put("case", name); out.put("variant", "__VARIANT__");
        out.put("sdk", android.os.Build.VERSION.SDK_INT); out.put("countryFixture", "HN");
        for(int i=0;i<values.length;i+=2) out.put(String.valueOf(values[i]),values[i+1]);
        try(FileOutputStream f=new FileOutputStream(new File(context().getCacheDir(),"brain-observations.jsonl"),true)) {
            f.write((out.toString()+"\n").getBytes(StandardCharsets.UTF_8));
        }
    }
    private static class Document extends clsDocCuenta {
        boolean throwing;
        Document(Context c) { super(c,48,"L",2,""); vendedor="synthetic"; }
        // Both variants receive the same private->protected test seam in the laboratory only.
        @Override protected boolean buildHeader() { return true; }
        @Override protected boolean buildDetail() { return true; }
        @Override protected boolean buildFooter() {
            if(throwing) throw new IllegalStateException("synthetic_injected_footer_failure");
            return super.buildFooter();
        }
        @Override public void setAddlog(String method,String message,String info) { }
        String render(double total,double discount,double percentage,boolean fixed,double amount) {
            ptotal=total;pdesc=discount;pprop=percentage;propfija=fixed;propvalor=amount;
            super.buildFooter(); return rep.build();
        }
    }
    @Test public void tipNotLostAfterWithoutThenWith() throws Exception {
        ExtractedTipProbe probe=new ExtractedTipProbe(context());
        double[] without=probe.project(true), with=probe.project(false);
        record("without_then_with", "initialTip",13.5,"modelTipAfterWithout",without[1],
               "printedWithoutTip",without[3],"printedWithTipAfterward",with[3]);
        assertEquals("WITH after WITHOUT must retain the original tip",13.5,with[3],0.001);
        assertEquals(13.5,without[1],0.001);
    }
    @Test public void explicitWithTipRecoversInheritedPercentage() throws Exception {
        ExtractedTipProbe probe=new ExtractedTipProbe(context());
        probe.gl.propina_vacia=true; probe.initializeChoice(); probe.confirmWithTip();
        record("explicit_with_tip", "configuredPercentage",10,"percentageAtPrint",probe.percentageAtPrint,
               "globalOmitAfterChoice",probe.gl.propina_vacia);
        assertEquals("an explicit WITH choice must recover an inherited zero",10,probe.percentageAtPrint,0);
    }
    @Test public void variableTipAppearsInFooter() throws Exception {
        Document doc=new Document(context()); String output=doc.render(148.5,0,0,false,13.5);
        boolean tip=output.contains("Propina:")&&output.contains("13.50");
        record("variable_tip_footer","tipPresent",tip,"totalPresent",output.contains("TOTAL A PAGAR:"));
        assertTrue("a positive variable tip must be rendered",tip);
        assertTrue(output.contains("TOTAL A PAGAR:"));
    }
    @Test public void documentExceptionCannotReportSuccess() throws Exception {
        Document doc=new Document(context()); doc.throwing=true;
        boolean result=doc.buildPrint("synthetic","A",148.5,0,10,true,13.5);
        record("document_exception","builderReportedSuccess",result);
        assertFalse("a caught generation exception must not report success",result);
    }
    @Test public void failedBuildCannotDispatchOlderReceipt() throws Exception {
        File previous=new File(context().getCacheDir(),"brain-stale-ticket.txt");
        Files.write(previous.toPath(),"SYNTHETIC_PREVIOUS_TIP=13.50".getBytes(StandardCharsets.UTF_8));
        Document doc=new Document(context());
        doc.rep=new clsRepBuilder(context(),48,true,"L",2,"") { @Override public boolean save(){return false;} };
        doc.rep.fname=previous.getAbsolutePath();
        ExtractedTipProbe probe=new ExtractedTipProbe(context());
        probe.tot=135;probe.propina=0;probe.propinaperc=0;probe.fdoc=doc;probe.app.path=previous;
        probe.dispatch();
        record("stale_receipt_dispatch","currentScreenModelTip",0,"dispatches",probe.app.calls,
               "oldTipArtifactDispatched",probe.app.seen.contains("13.50"));
        assertEquals("a failed build must not dispatch the previous receipt",0,probe.app.calls);
    }
    @Test public void fixedTipFooterStillWorks() throws Exception {
        String output=new Document(context()).render(148.5,0,10,true,13.5);
        record("control_fixed_tip_footer","tipPresent",output.contains("13.50"),"totalPresent",output.contains("148.50"));
        assertTrue(output.contains("Propina:")); assertTrue(output.contains("13.50"));assertTrue(output.contains("148.50"));
    }
    @Test public void explicitChoiceKeepsExclusions() throws Exception {
        ExtractedTipProbe p=new ExtractedTipProbe(context());p.gl.propina_vacia=true;p.gl.sin_propina=true;
        p.initializeChoice();p.confirmWithTip();
        record("control_no_tip_exclusion","percentageAtPrint",p.percentageAtPrint,"sinPropina",p.gl.sin_propina);
        assertEquals(0,p.percentageAtPrint,0);assertTrue(p.gl.sin_propina);
    }
}
