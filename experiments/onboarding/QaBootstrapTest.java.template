package com.dtsgt.brainlabtests;

import android.app.Activity;
import android.content.Intent;
import android.view.View;
import android.view.ViewGroup;
import android.widget.EditText;
import android.view.accessibility.AccessibilityNodeInfo;
import android.graphics.Rect;
import androidx.test.ext.junit.runners.AndroidJUnit4;
import androidx.test.platform.app.InstrumentationRegistry;
import androidx.test.runner.lifecycle.ActivityLifecycleMonitorRegistry;
import androidx.test.runner.lifecycle.Stage;
import com.dtsgt.mpos.MainActivity;
import com.dtsgt.mpos.WSRec;
import com.dtsgt.mpos.R;
import org.junit.Test;
import org.junit.runner.RunWith;
import org.json.JSONObject;
import org.json.JSONArray;
import java.io.File;
import java.io.FileOutputStream;
import java.nio.file.Files;
import java.nio.charset.StandardCharsets;
import java.util.concurrent.atomic.AtomicReference;
import static org.junit.Assert.*;

/** Actual Activity startup and QA receive. No sales, payments or send operations. */
@RunWith(AndroidJUnit4.class)
public class QaBootstrapTest {
    private final android.app.Instrumentation ins=InstrumentationRegistry.getInstrumentation();
    private Activity resumed() {
        AtomicReference<Activity> a=new AtomicReference<>();
        ins.runOnMainSync(()->{ for(Activity item: ActivityLifecycleMonitorRegistry.getInstance().getActivitiesInStage(Stage.RESUMED)) a.set(item); });
        return a.get();
    }
    private void tree(View v,JSONArray nodes) {
        JSONObject n=new JSONObject();
        try {
            String id="none";
            if(v.getId()!=View.NO_ID) try{id=v.getResources().getResourceEntryName(v.getId());}catch(Exception ignored){}
            n.put("id",id); n.put("type",v.getClass().getSimpleName()); n.put("visible",v.getVisibility()==View.VISIBLE);
            n.put("enabled",v.isEnabled()); n.put("bounds",new JSONArray(new int[]{v.getLeft(),v.getTop(),v.getRight(),v.getBottom()}));
            nodes.put(n);
            // Deliberately never capture widget text, EditText values, descriptions or hashes of input.
            if(v instanceof ViewGroup) for(int i=0;i<((ViewGroup)v).getChildCount();i++) tree(((ViewGroup)v).getChildAt(i),nodes);
        }catch(Exception ex){throw new RuntimeException("structural_fingerprint_failed");}
    }
    private void event(String stage,Activity a,boolean received) throws Exception {
        JSONObject out=new JSONObject(); out.put("stage",stage); out.put("received",received);
        out.put("activity",a==null?"none":a.getClass().getSimpleName());
        JSONArray nodes=new JSONArray();
        AccessibilityNodeInfo root=ins.getUiAutomation().getRootInActiveWindow();
        if(root!=null) accessibilityTree(root,nodes);
        else if(a!=null)ins.runOnMainSync(()->tree(a.getWindow().getDecorView(),nodes));
        out.put("nodes",nodes);
        try(FileOutputStream f=new FileOutputStream(new File(ins.getTargetContext().getCacheDir(),"brain-onboarding.jsonl"),true)) {
            f.write((out.toString()+"\n").getBytes(StandardCharsets.UTF_8));
        }
    }
    private void accessibilityTree(AccessibilityNodeInfo node,JSONArray rows) throws Exception {
        JSONObject row=new JSONObject();Rect bounds=new Rect();node.getBoundsInScreen(bounds);
        row.put("id",node.getViewIdResourceName()==null?"none":node.getViewIdResourceName());
        row.put("type",String.valueOf(node.getClassName()));row.put("visible",node.isVisibleToUser());row.put("enabled",node.isEnabled());
        row.put("bounds",new JSONArray(new int[]{bounds.left,bounds.top,bounds.right,bounds.bottom}));rows.put(row);
        for(int i=0;i<node.getChildCount();i++){AccessibilityNodeInfo child=node.getChild(i);if(child!=null)accessibilityTree(child,rows);}
    }
    @Test public void emptyDatabaseOpensCommunicationAndReceivesQa() throws Exception {
        JSONObject input=new JSONObject(new String(Files.readAllBytes(new File("/sdcard/Download/brain-qa-input.json").toPath()),StandardCharsets.UTF_8));
        Intent start=new Intent(ins.getTargetContext(),MainActivity.class);start.addFlags(Intent.FLAG_ACTIVITY_NEW_TASK);ins.getTargetContext().startActivity(start);
        Activity a=null; long deadline=System.currentTimeMillis()+90000;
        while(System.currentTimeMillis()<deadline){a=resumed();if(a instanceof WSRec)break;Thread.sleep(500);}
        event("startup",a,false); assertTrue("empty_database_did_not_open_communication",a instanceof WSRec);
        WSRec screen=(WSRec)a;
        ins.runOnMainSync(()->{
            ((EditText)screen.findViewById(R.id.txtEmpresa)).setText(input.optString("company"));
            ((EditText)screen.findViewById(R.id.txtClave)).setText(input.optString("key"));
            ((EditText)screen.findViewById(R.id.txtURLWS)).setText(input.optString("endpoint"));
        });
        event("communication_input_ready",screen,false);
        ins.runOnMainSync(()->screen.doStart(null));
        deadline=System.currentTimeMillis()+240000;
        boolean received=false; String last="";int lastPhaseCount=0;
        while(System.currentTimeMillis()<deadline){
            a=resumed();
            AtomicReference<Boolean> state=new AtomicReference<>(false);
            ins.runOnMainSync(()->state.set(screen.gl.estado_recep)); received=state.get();
            String current=a==null?"none":a.getClass().getSimpleName();
            if(!current.equals(last)){event("receive_navigation",a,received);last=current;}
            File phases=new File(ins.getTargetContext().getCacheDir(),"brain-sync-phase.jsonl");
            String phaseText=phases.isFile()?new String(Files.readAllBytes(phases.toPath()),StandardCharsets.UTF_8):"";
            int count=phaseText.split("\n").length;
            if(count!=lastPhaseCount){event("sync_phase_observation_"+count,a,received);lastPhaseCount=count;}
            boolean finalReturned=phaseText.contains("final_validations_returned");
            if(received&&finalReturned)break; Thread.sleep(1000);
        }
        event("receive_end",resumed(),received);
        // A missing selection or configuration is a documented stop, not permission to invent data.
        assertTrue("receive_not_completed_within_window_inspect_private_UI",received);
        File phases=new File(ins.getTargetContext().getCacheDir(),"brain-sync-phase.jsonl");
        assertTrue("base_applied_but_final_validation_not_observed",phases.isFile()&&new String(Files.readAllBytes(phases.toPath()),StandardCharsets.UTF_8).contains("final_validations_returned"));
    }
}
